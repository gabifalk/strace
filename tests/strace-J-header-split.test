#!/bin/sh
#
# Check the JSONL header event emitted by strace -J in split mode.
#
# Copyright (c) 2026 The strace developers.
# All rights reserved.
#
# SPDX-License-Identifier: GPL-2.0-or-later

. "${srcdir=.}/init.sh"

# Build the expected "capabilities" array from the same optional-feature
# list that --version reports, translating each token into an object.
features="$($STRACE --version | sed -n 's/^Optional features enabled: //p')"
[ "$features" = '(none)' ] && features=

caps=
for tok in $features; do
	case "$tok" in
	no-*)	obj="{\"name\": \"${tok#no-}\", \"disabled\": true}" ;;
	*=*)	obj="{\"name\": \"${tok%%=*}\", \"value\": \"${tok#*=}\"}" ;;
	*)	obj="{\"name\": \"$tok\"}" ;;
	esac
	caps="${caps:+$caps, }$obj"
done

ver="$(get_config_str PACKAGE_VERSION)"

cat > "$EXP" <<__EOF__
{"event": "header", "version": 1, "strace_version": "$ver", "format": "jsonl-split", "options": {"xlat": "abbrev", "follow_forks": false, "syscall_number": false, "arg_names": false, "strings_in_hex": "none", "decode_pid_comm": false, "acolumn": 40, "output_separately": false}, "capabilities": [$caps]}
__EOF__

run_strace -J -e trace=sysinfo ../jsonl-sysinfo > /dev/null
head -n 1 < "$LOG" > "$OUT"

match_diff "$OUT" "$EXP"
